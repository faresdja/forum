# ============================================================
# .htaccess — إعادة الكتابة إلى الواجهة الأمامية MVC (index.php)
# ============================================================

RewriteEngine On
RewriteBase /

# 1) الملفات والمجلدات الحقيقية تُخدم مباشرة (css, js, img, install...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) الروابط القديمة => روابط الراوتر الجديدة
RewriteRule ^blog\.html$        /home            [L,QSA]
RewriteRule ^last\.html$        /home?page=last  [L,QSA]
RewriteRule ^sticky\.html$      /home?page=sticky [L,QSA]
RewriteRule ^forums\.html$      /forums          [L,QSA]
RewriteRule ^mixt\.html$        /home?page=mixt  [L,QSA]

RewriteRule ^forum\.php&id=([0-9]+)$                 /forum/$1 [L,QSA]
RewriteRule ^forum\.php&id=([0-9]+)&page=([0-9]+)$   /forum/$1?page=$2 [L,QSA]
RewriteRule ^topic\.php&id=([0-9]+)$                 /topic/$1 [L,QSA]
RewriteRule ^topic\.php&id=([0-9]+)&n=([0-9]+)$      /topic/$1/$2 [L,QSA]

RewriteRule ^notifications\.html$ /home?op=noti [L,QSA]
RewriteRule ^profile\.php$        /user         [L,QSA]
RewriteRule ^register\.php$       /register     [L,QSA]
RewriteRule ^sign-up\.joined$     /register     [L,QSA]

# 3) كل ما عدا ذلك يمر عبر الواجهة الأمامية MVC
RewriteRule ^(.*)$ index.php [QSA,L]
